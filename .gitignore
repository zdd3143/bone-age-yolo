# ============================================================
# 骨龄检测项目 · git 忽略规则
# ============================================================
# 判断标准：**能由脚本重新生成的、体积大的、或者涉及授权的，都不进仓库。**

# ---------------- Python ----------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------------- 密钥 ----------------
# .env 里放的是 API key，绝对不进仓库
.env
.env.*

# ---------------- 数据集 ----------------
# data/ 下是 881 张手部 X 光片 + 标签，约 1.4 GB，
# 而且原始影像涉及医学数据授权，不进仓库。
# 重新生成方式：python src/stage2_voc2yolo.py
data/

# ---------------- 训练产物 / 推理缓存 ----------------
# outputs/ 下是权重、混淆矩阵、PR 曲线、检测缓存（合计 70+ MB），
# 全部可由脚本重新跑出来。
# 重新生成方式：python src/stage3_train.py
outputs/

# ---------------- 预训练权重 ----------------
# 可由 python src/download_weights.py 重新下载
*.pt
*.pth
weights/

# ---------------- 数据集配置（含本机绝对路径）----------------
# configs/bone_age.yaml 由 stage2_voc2yolo.py 自动生成，
# 里面的 path 是本机绝对路径，对别人没有意义。
# 类别映射写进了 README，需要时重跑 stage2 即可。
configs/*.yaml

# ---------------- 编辑器 / 系统 ----------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
